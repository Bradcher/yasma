---
layout: base.njk
---

{% if featured_image %}
<div class="post-hero">
  <img src="{{ featured_image }}" alt="{{ title }}" class="post-hero-img" />
</div>
{% endif %}

<article class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      {% if categories and categories.length %}
      <div class="mb-3">
        {% for cat in categories %}
        <a href="/blog/category/{{ cat | slugify }}/" class="category-pill me-1">{{ cat }}</a>
        {% endfor %}
      </div>
      {% endif %}

      <h1 class="fw-bold mb-3" style="color:#0c1c2c; line-height:1.3;">{{ title }}</h1>

      <div class="post-meta mb-4">
        <time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
        <span class="mx-2" aria-hidden="true">·</span>
        <span>{{ content | readingTime }} min read</span>
      </div>

      <hr class="mb-4" />

      <div class="post-content">
        {{ content | safe }}
      </div>

      <hr class="mt-5 mb-4" />

      {% if tags and tags.length %}
      <div class="post-tags mb-5">
        <strong class="me-2" style="color:#0c1c2c;">Tags:</strong>
        {% for tag in tags %}
        <a href="/blog/tag/{{ tag | slugify }}/" class="tag-pill me-1 mb-1">{{ tag }}</a>
        {% endfor %}
      </div>
      {% endif %}

    </div>
  </div>
</article>

{% set recentPosts = collections.posts | except(page.url) | limit(3) %}
{% if recentPosts.length %}
<section class="recent-posts-section py-5" aria-label="Recent posts">
  <div class="container">
    <h2 class="fw-bold mb-4 text-center" style="color:#0c1c2c;">Recent Posts</h2>
    <div class="row g-4">
      {% for post in recentPosts %}
      <div class="col-md-4">
        <a href="{{ post.url }}" class="blog-card d-flex flex-column text-decoration-none h-100">
          {% if post.data.featured_image %}
          <img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}" class="blog-card-img" />
          {% else %}
          <div class="blog-card-img blog-card-img--placeholder"></div>
          {% endif %}
          <div class="blog-card-body flex-grow-1">
            {% if post.data.categories and post.data.categories.length %}
            <span class="category-pill mb-2 d-inline-block">{{ post.data.categories[0] }}</span>
            {% endif %}
            <h3 class="blog-card-title">{{ post.data.title }}</h3>
            <p class="blog-card-date">{{ post.date | dateDisplay }}</p>
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
