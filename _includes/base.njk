<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% if meta_title %}{{ meta_title }}{% elif title %}{{ title }} | The Yasma Screen{% else %}The Yasma Screen{% endif %}</title>

    <meta name="description" content="{{ meta_description or excerpt or 'Custom pool cages, pergolas, lanais, hurricane screens &amp; rescreening across Florida. Serving Cape Coral, Fort Myers, Naples &amp; beyond.' }}" />

    <link rel="canonical" href="https://www.theyasmascreen.com{{ page.url }}" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content="{{ 'article' if postType == 'article' else 'website' }}" />
    <meta property="og:site_name" content="The Yasma Screen" />
    <meta property="og:title" content="{{ meta_title or title or 'The Yasma Screen' }}" />
    <meta property="og:description" content="{{ meta_description or excerpt or '' }}" />
    <meta property="og:url" content="https://www.theyasmascreen.com{{ page.url }}" />
    <meta property="og:image" content="https://www.theyasmascreen.com{{ featured_image or '/img/hero1.JPG' }}" />
    <meta property="og:locale" content="en_US" />
    {% if postType == 'article' and date %}
    <meta property="article:published_time" content="{{ date | dateISO }}" />
    {% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ meta_title or title or 'The Yasma Screen' }}" />
    <meta name="twitter:description" content="{{ meta_description or excerpt or '' }}" />
    <meta name="twitter:image" content="https://www.theyasmascreen.com{{ featured_image or '/img/hero1.JPG' }}" />

    <meta name="theme-color" content="#0c1c2c" />

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="alternate" type="application/rss+xml" title="The Yasma Screen Blog" href="/feed.xml" />
  </head>

  <body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm py-3" aria-label="Main navigation">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <img src="/img/logo.JPEG" alt="The Yasma Screen logo — pool cages, pergolas and screening in Florida" class="logo me-2" />
          <span class="fw-bold">The Yasma Screen</span>
        </a>
        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/services.html">Services</a></li>
            <li class="nav-item"><a class="nav-link" href="/gallery.html">Gallery</a></li>
            <li class="nav-item"><a class="nav-link" href="/about.html">About</a></li>
            <li class="nav-item"><a class="nav-link{% if '/blog' in page.url %} active{% endif %}" href="/blog/" {% if '/blog' in page.url %}aria-current="page"{% endif %}>Blog</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <main>
      {{ content | safe }}
    </main>

    <!-- FOOTER -->
    <footer class="footer text-white py-5 mt-5">
      <div class="container">
        <div class="row align-items-center text-center text-md-start">

          <div class="col-md-6 mb-4 mb-md-0 d-flex flex-column align-items-center align-items-md-start">
            <img src="/img/logo.JPEG" alt="The Yasma Screen logo" style="max-width: 150px;" width="150" height="150" class="mb-3" />
            <a href="https://www.instagram.com/the_yasma_screen/" target="_blank" rel="noopener noreferrer"
               class="btn instagram-btn px-3 py-1 d-inline-flex align-items-center"
               style="color: #0c1c2c !important; background: #fff !important; font-weight: 600; text-decoration: none;">
              <i class="fab fa-instagram me-2"></i> Follow on Instagram
            </a>
            <a href="https://www.facebook.com/p/The-Yasma-Screen-61577878375670/" target="_blank" rel="noopener noreferrer"
               class="btn instagram-btn px-3 py-1 d-inline-flex align-items-center mt-2"
               style="color: #0c1c2c !important; background: #fff !important; font-weight: 600; text-decoration: none;">
              <i class="fab fa-facebook-f me-2"></i> Follow on Facebook
            </a>
            <div class="mt-3" style="text-align:center;">
              <div style="display:flex; align-items:center; gap:6px; font-weight:600; color:white; margin-bottom:4px;">
                <i class="fas fa-phone"></i>
                <a href="tel:4804140970" style="color:white; text-decoration:none;">480-414-0970</a>
              </div>
              <div style="display:flex; align-items:center; gap:6px; font-weight:600; color:white;">
                <i class="fas fa-phone"></i>
                <a href="tel:7377083179" style="color:white; text-decoration:none;">737-708-3179</a>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <h5>Business Hours</h5>
            <ul class="list-unstyled small mb-0">
              <li><strong>Mon</strong>: 9:00 AM – 5:00 PM</li>
              <li><strong>Tue</strong>: 9:00 AM – 5:00 PM</li>
              <li><strong>Wed</strong>: 9:00 AM – 5:00 PM</li>
              <li><strong>Thu</strong>: 9:00 AM – 5:00 PM</li>
              <li><strong>Fri</strong>: 9:00 AM – 5:00 PM</li>
              <li><strong>Sat</strong>: 9:00 AM – 5:00 PM</li>
              <li><strong>Sun</strong>: Closed</li>
            </ul>
          </div>

        </div>
        <hr class="border-secondary my-4" />
        <p class="copy text-center small mb-0">&copy; 2025 The Yasma Screen. All rights reserved.</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
